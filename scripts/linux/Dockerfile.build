# Build box for the Linux packages: Ubuntu 22.04 for the oldest glibc we target.
FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential curl wget file ca-certificates git pkg-config rsync xz-utils patchelf \
    libwebkit2gtk-4.1-dev libxdo-dev libssl-dev libayatana-appindicator3-dev librsvg2-dev \
    xvfb xauth dbus-x11 pulseaudio pulseaudio-utils xdotool imagemagick python3 python3-gi gir1.2-gtk-3.0 \
    gstreamer1.0-plugins-good gstreamer1.0-plugins-bad gstreamer1.0-libav gstreamer1.0-tools \
    playerctl libfuse2 squashfs-tools \
 && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && apt-get install -y nodejs && rm -rf /var/lib/apt/lists/*
RUN curl https://sh.rustup.rs -sSf | sh -s -- -y --profile minimal
ENV PATH=/root/.cargo/bin:$PATH APPIMAGE_EXTRACT_AND_RUN=1
WORKDIR /work
