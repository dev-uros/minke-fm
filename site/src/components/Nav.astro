---
import { Image } from 'astro:assets'
import icon from '../assets/icon.png'
import { NAME } from '../constants'

interface Props {
  /** Links to the sections of the home page; left out on the other pages. */
  sections?: boolean
}

const { sections = false } = Astro.props
---

<header class="nav wrap">
  <a class="nav__brand" href="/">
    <Image src={icon} width={44} height={44} densities={[1, 2]} alt="" class="nav__logo" loading="eager" />
    <span>{NAME}</span>
  </a>
  {
    sections && (
      <nav class="nav__links" aria-label="On this page">
        <a href="#genres">Genres</a>
        <a href="#countries">Countries</a>
        <a href="#faq">FAQ</a>
        <a href="#get">Get the app</a>
      </nav>
    )
  }
</header>

<style>
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 20px;
  }
  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: var(--display-weight);
    text-shadow: var(--glow);
    text-decoration: none;
  }
  .nav__logo {
    width: 44px;
    height: 44px;
    border-radius: 11px;
  }
  .nav__links {
    display: flex;
    gap: clamp(14px, 3vw, 28px);
    font-size: 16px;
    font-weight: 600;
  }
  .nav__links a {
    color: var(--ink);
    text-decoration: none;
  }
  .nav__links a:hover {
    color: var(--accent);
  }
  @media (max-width: 560px) {
    .nav__links a:not(:last-child) {
      display: none;
    }
  }
</style>
