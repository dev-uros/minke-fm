// The site on Cloudflare: every page is a static asset, served as it is. No Worker code.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "minke-fm-site",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "minkefm.fifthguild.com", "custom_domain": true }],
  "observability": { "enabled": true }
}
