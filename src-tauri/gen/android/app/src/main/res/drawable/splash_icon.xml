<?xml version="1.0" encoding="utf-8"?>
<!--
    The launcher icon is a full-bleed rounded square with a wide wordmark, and
    Android 12+ masks the splash icon into a circle. Inset so the mark lands
    inside that circle instead of having its edges shaved off.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:drawable="@mipmap/ic_launcher"
        android:left="26dp"
        android:top="26dp"
        android:right="26dp"
        android:bottom="26dp" />
</layer-list>
