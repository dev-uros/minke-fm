<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.minke_fm" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Without this the window falls back to the DayNight default, which
             is what showed as a flash between the splash lifting and the page
             painting. -->
        <item name="android:windowBackground">@color/minke_background</item>
    </style>

    <!-- The launch theme. Android swaps to Theme.minke_fm once the splash is
         dismissed; both share one background so the swap is invisible. -->
    <style name="Theme.minke_fm.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/minke_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.minke_fm</item>
    </style>
</resources>
